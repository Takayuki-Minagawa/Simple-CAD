{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-web-cad.example/project.schema.json",
  "title": "Structural CAD Project",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "stories",
    "grids",
    "materials",
    "sections",
    "members",
    "openings",
    "annotations",
    "dimensions",
    "sheets",
    "views"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "project": { "$ref": "#/$defs/ProjectMeta" },
    "stories": {
      "type": "array",
      "items": { "$ref": "#/$defs/Story" }
    },
    "grids": {
      "type": "array",
      "items": { "$ref": "#/$defs/Grid" }
    },
    "materials": {
      "type": "array",
      "items": { "$ref": "#/$defs/Material" }
    },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/Section" }
    },
    "members": {
      "type": "array",
      "items": { "$ref": "#/$defs/Member" }
    },
    "openings": {
      "type": "array",
      "items": { "$ref": "#/$defs/Opening" }
    },
    "annotations": {
      "type": "array",
      "items": { "$ref": "#/$defs/Annotation" }
    },
    "dimensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/Dimension" }
    },
    "sheets": {
      "type": "array",
      "items": { "$ref": "#/$defs/Sheet" }
    },
    "views": {
      "type": "array",
      "items": { "$ref": "#/$defs/View" }
    },
    "issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/Issue" }
    },
    "groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/Group" }
    },
    "constructionLines": {
      "type": "array",
      "items": { "$ref": "#/$defs/ConstructionLine" }
    },
    "externalRefs": {
      "type": "array",
      "items": { "$ref": "#/$defs/ExternalRef" }
    },
    "loadCases": {
      "type": "array",
      "items": { "$ref": "#/$defs/LoadCase" }
    },
    "supports": {
      "type": "array",
      "items": { "$ref": "#/$defs/StructuralSupport" }
    },
    "nodalLoads": {
      "type": "array",
      "items": { "$ref": "#/$defs/NodalLoad" }
    },
    "memberLoads": {
      "type": "array",
      "items": { "$ref": "#/$defs/MemberLoad" }
    },
    "areaLoads": {
      "type": "array",
      "items": { "$ref": "#/$defs/AreaLoad" }
    },
    "loadCombinations": {
      "type": "array",
      "items": { "$ref": "#/$defs/LoadCombination" }
    },
    "masses": {
      "type": "array",
      "items": { "$ref": "#/$defs/LumpedMass" }
    },
    "diaphragms": {
      "type": "array",
      "items": { "$ref": "#/$defs/Diaphragm" }
    },
    "analysisResults": {
      "$ref": "#/$defs/AnalysisResultsMetadata"
    }
  },
  "$defs": {
    "LineType": {
      "type": "string",
      "enum": ["solid", "dashed", "dotted", "chain", "dashdot"]
    },
    "TextAlign": {
      "type": "string",
      "enum": ["left", "center", "right"]
    },
    "Point2D": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "Point3D": {
      "type": "object",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "ProjectMeta": {
      "type": "object",
      "required": ["id", "name", "unit"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "const": "mm" }
      }
    },
    "Story": {
      "type": "object",
      "required": ["id", "name", "elevation", "height"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "elevation": { "type": "number" },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "deadLoad": { "type": "number", "minimum": 0 },
        "liveLoad": { "type": "number", "minimum": 0 }
      }
    },
    "Grid": {
      "type": "object",
      "required": ["id", "axis", "name", "position"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "axis": { "type": "string", "enum": ["X", "Y"] },
        "name": { "type": "string" },
        "position": { "type": "number" }
      }
    },
    "Material": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "name", "type"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "name": { "type": "string" },
            "type": { "const": "concrete" },
            "elasticModulus": { "type": "number", "exclusiveMinimum": 0 },
            "shearModulus": { "type": "number", "exclusiveMinimum": 0 },
            "poissonRatio": { "type": "number", "minimum": 0, "exclusiveMaximum": 0.5 },
            "unitWeight": { "type": "number", "minimum": 0 },
            "Fc": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["id", "name", "type"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "name": { "type": "string" },
            "type": { "const": "steel" },
            "elasticModulus": { "type": "number", "exclusiveMinimum": 0 },
            "shearModulus": { "type": "number", "exclusiveMinimum": 0 },
            "poissonRatio": { "type": "number", "minimum": 0, "exclusiveMaximum": 0.5 },
            "unitWeight": { "type": "number", "minimum": 0 },
            "F": { "type": "number", "exclusiveMinimum": 0 },
            "Fy": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["id", "name", "type"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "name": { "type": "string" },
            "type": { "const": "wood" },
            "elasticModulus": { "type": "number", "exclusiveMinimum": 0 },
            "shearModulus": { "type": "number", "exclusiveMinimum": 0 },
            "poissonRatio": { "type": "number", "minimum": 0, "exclusiveMaximum": 0.5 },
            "unitWeight": { "type": "number", "minimum": 0 },
            "referenceStrength": { "type": "number", "exclusiveMinimum": 0 },
            "moistureContent": { "type": "number", "minimum": 0, "maximum": 100 },
            "allowableBendingStress": { "type": "number", "exclusiveMinimum": 0 },
            "allowableCompressionStress": { "type": "number", "exclusiveMinimum": 0 },
            "allowableShearStress": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["id", "name", "type"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "name": { "type": "string" },
            "type": { "const": "other" },
            "elasticModulus": { "type": "number", "exclusiveMinimum": 0 },
            "shearModulus": { "type": "number", "exclusiveMinimum": 0 },
            "poissonRatio": { "type": "number", "minimum": 0, "exclusiveMaximum": 0.5 },
            "unitWeight": { "type": "number", "minimum": 0 }
          }
        }
      ]
    },
    "LoadCase": {
      "type": "object",
      "required": ["id", "name", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["dead", "live", "snow", "wind", "seismic", "other"]
        },
        "factor": { "type": "number" }
      }
    },
    "DofRestraint": {
      "type": "object",
      "required": ["ux", "uy", "uz", "rx", "ry", "rz"],
      "additionalProperties": false,
      "properties": {
        "ux": { "type": "boolean" },
        "uy": { "type": "boolean" },
        "uz": { "type": "boolean" },
        "rx": { "type": "boolean" },
        "ry": { "type": "boolean" },
        "rz": { "type": "boolean" }
      }
    },
    "DofRelease": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ux": { "type": "boolean" },
        "uy": { "type": "boolean" },
        "uz": { "type": "boolean" },
        "rx": { "type": "boolean" },
        "ry": { "type": "boolean" },
        "rz": { "type": "boolean" }
      }
    },
    "MemberReleases": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": { "$ref": "#/$defs/DofRelease" },
        "end": { "$ref": "#/$defs/DofRelease" }
      }
    },
    "RigidZones": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 }
      }
    },
    "LocalAxisDefinition": {
      "type": "object",
      "required": ["rotation"],
      "additionalProperties": false,
      "properties": {
        "rotation": { "type": "number" },
        "referenceVector": { "$ref": "#/$defs/Point3D" }
      }
    },
    "StructuralSupport": {
      "type": "object",
      "required": ["id", "storyId", "position", "restraints"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "storyId": { "type": "string", "minLength": 1 },
        "position": { "$ref": "#/$defs/Point3D" },
        "restraints": { "$ref": "#/$defs/DofRestraint" }
      }
    },
    "LoadVector3D": {
      "type": "object",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "MassVector3D": {
      "type": "object",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "z": { "type": "number", "minimum": 0 }
      }
    },
    "LoadDirection": {
      "type": "string",
      "enum": ["globalX", "globalY", "globalZ", "localX", "localY", "localZ"]
    },
    "NodalLoad": {
      "type": "object",
      "required": ["id", "loadCaseId", "storyId", "position", "force"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "loadCaseId": { "type": "string", "minLength": 1 },
        "storyId": { "type": "string", "minLength": 1 },
        "position": { "$ref": "#/$defs/Point3D" },
        "force": { "$ref": "#/$defs/LoadVector3D" },
        "moment": { "$ref": "#/$defs/LoadVector3D" }
      }
    },
    "MemberLoad": {
      "type": "object",
      "required": ["id", "loadCaseId", "memberId", "kind", "direction", "magnitude"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "loadCaseId": { "type": "string", "minLength": 1 },
        "memberId": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["point", "uniform", "trapezoidal"] },
        "direction": { "$ref": "#/$defs/LoadDirection" },
        "magnitude": { "type": "number" },
        "endMagnitude": { "type": "number" },
        "position": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "point" } } },
          "then": { "required": ["position"] }
        },
        {
          "if": { "properties": { "kind": { "const": "trapezoidal" } } },
          "then": { "required": ["endMagnitude"] }
        },
        {
          "if": { "properties": { "kind": { "const": "uniform" } } },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["position"] },
                { "required": ["endMagnitude"] }
              ]
            }
          }
        }
      ]
    },
    "AreaLoad": {
      "type": "object",
      "required": ["id", "loadCaseId", "memberId", "direction", "magnitude"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "loadCaseId": { "type": "string", "minLength": 1 },
        "memberId": { "type": "string", "minLength": 1 },
        "direction": { "$ref": "#/$defs/LoadDirection" },
        "magnitude": { "type": "number" }
      }
    },
    "LoadCombination": {
      "type": "object",
      "required": ["id", "name", "type", "factors"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["linear", "envelope"] },
        "factors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["loadCaseId", "factor"],
            "additionalProperties": false,
            "properties": {
              "loadCaseId": { "type": "string", "minLength": 1 },
              "factor": { "type": "number" }
            }
          }
        }
      }
    },
    "LumpedMass": {
      "type": "object",
      "required": ["id", "storyId", "position", "mass"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "storyId": { "type": "string", "minLength": 1 },
        "position": { "$ref": "#/$defs/Point3D" },
        "mass": { "$ref": "#/$defs/MassVector3D" },
        "rotationalMass": { "$ref": "#/$defs/MassVector3D" }
      }
    },
    "Diaphragm": {
      "type": "object",
      "required": ["id", "storyId", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "storyId": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["rigid", "semiRigid"] },
        "memberIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "masterPosition": { "$ref": "#/$defs/Point3D" }
      }
    },
    "AnalysisNodeDisplacement": {
      "type": "object",
      "required": ["position", "dx", "dy", "dz"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "position": { "$ref": "#/$defs/Point3D" },
        "dx": { "type": "number" },
        "dy": { "type": "number" },
        "dz": { "type": "number" },
        "rx": { "type": "number" },
        "ry": { "type": "number" },
        "rz": { "type": "number" }
      }
    },
    "AnalysisMemberResult": {
      "type": "object",
      "required": ["memberId"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "memberId": { "type": "string", "minLength": 1 },
        "axial": { "type": "number" },
        "shearY": { "type": "number" },
        "shearZ": { "type": "number" },
        "momentY": { "type": "number" },
        "momentZ": { "type": "number" },
        "utilization": { "type": "number", "minimum": 0 }
      }
    },
    "AnalysisResultsMetadata": {
      "type": "object",
      "required": ["source", "analysisType", "generatedAt"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "solver": { "type": "string" },
        "analysisType": { "type": "string", "enum": ["static", "modal", "buckling", "timeHistory", "other"] },
        "generatedAt": { "type": "string" },
        "caseId": { "type": "string", "minLength": 1 },
        "combinationId": { "type": "string", "minLength": 1 },
        "deformationScale": { "type": "number", "exclusiveMinimum": 0 },
        "nodeDisplacements": { "type": "array", "items": { "$ref": "#/$defs/AnalysisNodeDisplacement" } },
        "memberResults": { "type": "array", "items": { "$ref": "#/$defs/AnalysisMemberResult" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "RebarSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mainDiameter": { "type": "number", "exclusiveMinimum": 0 },
        "mainCount": { "type": "integer", "minimum": 0 },
        "hoopDiameter": { "type": "number", "exclusiveMinimum": 0 },
        "hoopSpacing": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "GridRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startGrid": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2,
          "maxItems": 2
        },
        "endGrid": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "AxisOffset": {
      "type": "object",
      "required": ["dx", "dy"],
      "additionalProperties": false,
      "properties": {
        "dx": { "type": "number" },
        "dy": { "type": "number" }
      }
    },
    "Section": {
      "oneOf": [
        { "$ref": "#/$defs/RectColumnSection" },
        { "$ref": "#/$defs/RectBeamSection" },
        { "$ref": "#/$defs/SlabSection" },
        { "$ref": "#/$defs/WallSection" },
        { "$ref": "#/$defs/SteelColumnHSection" },
        { "$ref": "#/$defs/SteelBeamHSection" },
        { "$ref": "#/$defs/SteelPipeSection" }
      ]
    },
    "RectColumnSection": {
      "type": "object",
      "required": ["id", "kind", "width", "depth"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "const": "rc_column_rect" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "depth": { "type": "number", "exclusiveMinimum": 0 },
        "cover": { "type": "number", "minimum": 0 },
        "rebar": { "$ref": "#/$defs/RebarSpec" }
      }
    },
    "RectBeamSection": {
      "type": "object",
      "required": ["id", "kind", "width", "depth"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "const": "rc_beam_rect" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "depth": { "type": "number", "exclusiveMinimum": 0 },
        "cover": { "type": "number", "minimum": 0 },
        "rebar": { "$ref": "#/$defs/RebarSpec" }
      }
    },
    "SlabSection": {
      "type": "object",
      "required": ["id", "kind", "thickness"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "const": "rc_slab" },
        "thickness": { "type": "number", "exclusiveMinimum": 0 },
        "cover": { "type": "number", "minimum": 0 },
        "deadLoad": { "type": "number", "minimum": 0 },
        "liveLoad": { "type": "number", "minimum": 0 }
      }
    },
    "WallSection": {
      "type": "object",
      "required": ["id", "kind", "thickness"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "const": "rc_wall" },
        "thickness": { "type": "number", "exclusiveMinimum": 0 },
        "cover": { "type": "number", "minimum": 0 }
      }
    },
    "SteelColumnHSection": {
      "type": "object",
      "required": ["id", "kind", "width", "depth"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "const": "s_column_h" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "depth": { "type": "number", "exclusiveMinimum": 0 },
        "tw": { "type": "number", "exclusiveMinimum": 0 },
        "tf": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "SteelBeamHSection": {
      "type": "object",
      "required": ["id", "kind", "width", "depth"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "const": "s_beam_h" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "depth": { "type": "number", "exclusiveMinimum": 0 },
        "tw": { "type": "number", "exclusiveMinimum": 0 },
        "tf": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "SteelPipeSection": {
      "type": "object",
      "required": ["id", "kind", "diameter", "thickness"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "const": "s_pipe" },
        "diameter": { "type": "number", "exclusiveMinimum": 0 },
        "thickness": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "Member": {
      "oneOf": [
        { "$ref": "#/$defs/ColumnMember" },
        { "$ref": "#/$defs/BeamMember" },
        { "$ref": "#/$defs/WallMember" },
        { "$ref": "#/$defs/SlabMember" }
      ]
    },
    "ColumnMember": {
      "type": "object",
      "required": ["id", "type", "story", "sectionId", "materialId", "start", "end"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "const": "column" },
        "story": { "type": "string", "minLength": 1 },
        "sectionId": { "type": "string", "minLength": 1 },
        "materialId": { "type": "string", "minLength": 1 },
        "start": { "$ref": "#/$defs/Point3D" },
        "end": { "$ref": "#/$defs/Point3D" },
        "rotation": { "type": "number" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "color": { "type": "string" },
        "lineWeight": { "type": "number", "exclusiveMinimum": 0 },
        "lineType": { "$ref": "#/$defs/LineType" },
        "gridRef": { "$ref": "#/$defs/GridRef" },
        "axisOffset": { "$ref": "#/$defs/AxisOffset" },
        "faceAlign": { "type": "string", "enum": ["center", "left", "right"] },
        "releases": { "$ref": "#/$defs/MemberReleases" },
        "rigidZones": { "$ref": "#/$defs/RigidZones" },
        "localAxis": { "$ref": "#/$defs/LocalAxisDefinition" }
      }
    },
    "BeamMember": {
      "type": "object",
      "required": ["id", "type", "story", "sectionId", "materialId", "start", "end"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "const": "beam" },
        "story": { "type": "string", "minLength": 1 },
        "sectionId": { "type": "string", "minLength": 1 },
        "materialId": { "type": "string", "minLength": 1 },
        "start": { "$ref": "#/$defs/Point3D" },
        "end": { "$ref": "#/$defs/Point3D" },
        "rotation": { "type": "number" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "color": { "type": "string" },
        "lineWeight": { "type": "number", "exclusiveMinimum": 0 },
        "lineType": { "$ref": "#/$defs/LineType" },
        "gridRef": { "$ref": "#/$defs/GridRef" },
        "axisOffset": { "$ref": "#/$defs/AxisOffset" },
        "faceAlign": { "type": "string", "enum": ["center", "left", "right"] },
        "releases": { "$ref": "#/$defs/MemberReleases" },
        "rigidZones": { "$ref": "#/$defs/RigidZones" },
        "localAxis": { "$ref": "#/$defs/LocalAxisDefinition" }
      }
    },
    "WallMember": {
      "type": "object",
      "required": [
        "id", "type", "story", "sectionId", "materialId",
        "start", "end", "height", "thickness"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "const": "wall" },
        "story": { "type": "string", "minLength": 1 },
        "sectionId": { "type": "string", "minLength": 1 },
        "materialId": { "type": "string", "minLength": 1 },
        "start": { "$ref": "#/$defs/Point3D" },
        "end": { "$ref": "#/$defs/Point3D" },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "thickness": { "type": "number", "exclusiveMinimum": 0 },
        "rotation": { "type": "number" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "color": { "type": "string" },
        "lineWeight": { "type": "number", "exclusiveMinimum": 0 },
        "lineType": { "$ref": "#/$defs/LineType" },
        "gridRef": { "$ref": "#/$defs/GridRef" },
        "axisOffset": { "$ref": "#/$defs/AxisOffset" },
        "faceAlign": { "type": "string", "enum": ["center", "left", "right"] },
        "releases": { "$ref": "#/$defs/MemberReleases" },
        "rigidZones": { "$ref": "#/$defs/RigidZones" },
        "localAxis": { "$ref": "#/$defs/LocalAxisDefinition" }
      }
    },
    "SlabMember": {
      "type": "object",
      "required": ["id", "type", "story", "sectionId", "materialId", "polygon", "level"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "const": "slab" },
        "story": { "type": "string", "minLength": 1 },
        "sectionId": { "type": "string", "minLength": 1 },
        "materialId": { "type": "string", "minLength": 1 },
        "polygon": {
          "type": "array",
          "items": { "$ref": "#/$defs/Point2D" },
          "minItems": 3
        },
        "level": { "type": "number" },
        "rotation": { "type": "number" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "color": { "type": "string" },
        "lineWeight": { "type": "number", "exclusiveMinimum": 0 },
        "lineType": { "$ref": "#/$defs/LineType" },
        "fillColor": { "type": "string" },
        "fillOpacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "gridRef": { "$ref": "#/$defs/GridRef" },
        "axisOffset": { "$ref": "#/$defs/AxisOffset" },
        "faceAlign": { "type": "string", "enum": ["center", "left", "right"] },
        "releases": { "$ref": "#/$defs/MemberReleases" },
        "rigidZones": { "$ref": "#/$defs/RigidZones" },
        "localAxis": { "$ref": "#/$defs/LocalAxisDefinition" }
      }
    },
    "Opening": {
      "type": "object",
      "required": ["id", "memberId", "type", "position", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "memberId": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["door", "window", "void"] },
        "position": { "$ref": "#/$defs/Point3D" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "Annotation": {
      "type": "object",
      "required": ["id", "type", "story", "x", "y", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["text", "label", "leader", "spline"] },
        "story": { "type": "string", "minLength": 1 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "text": { "type": "string" },
        "fontSize": { "type": "number", "exclusiveMinimum": 0 },
        "rotation": { "type": "number" },
        "color": { "type": "string" },
        "textAlign": { "$ref": "#/$defs/TextAlign" },
        "fontWeight": { "type": "string", "enum": ["normal", "bold"] },
        "fontStyle": { "type": "string", "enum": ["normal", "italic"] },
        "textDecoration": { "type": "string", "enum": ["none", "underline"] },
        "fontFamily": { "type": "string" },
        "points": {
          "type": "array",
          "items": { "$ref": "#/$defs/Point2D" },
          "minItems": 2
        }
      }
    },
    "Dimension": {
      "type": "object",
      "required": ["id", "story", "start", "end", "offset"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "story": { "type": "string", "minLength": 1 },
        "start": { "$ref": "#/$defs/Point2D" },
        "end": { "$ref": "#/$defs/Point2D" },
        "offset": { "type": "number" },
        "text": { "type": "string" },
        "color": { "type": "string" },
        "lineWeight": { "type": "number", "exclusiveMinimum": 0 },
        "lineType": { "$ref": "#/$defs/LineType" },
        "associative": { "type": "boolean" },
        "refMemberIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "View": {
      "oneOf": [
        { "$ref": "#/$defs/PlanView" },
        { "$ref": "#/$defs/Model3DView" }
      ]
    },
    "PlanView": {
      "type": "object",
      "required": ["id", "type", "story", "center", "width", "height", "rotation"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "const": "plan" },
        "story": { "type": "string", "minLength": 1 },
        "center": { "$ref": "#/$defs/Point2D" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "rotation": { "type": "number" }
      }
    },
    "Model3DView": {
      "type": "object",
      "required": ["id", "type", "story"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "const": "model3d" },
        "story": { "type": "string", "minLength": 1 }
      }
    },
    "Viewport": {
      "type": "object",
      "required": ["id", "sheetId", "viewId", "x", "y", "width", "height", "scale"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sheetId": { "type": "string", "minLength": 1 },
        "viewId": { "type": "string", "minLength": 1 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "scale": { "type": "string", "pattern": "^1:\\d+$" }
      }
    },
    "Sheet": {
      "type": "object",
      "required": ["id", "name", "paperSize", "scale", "viewIds"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "paperSize": {
          "type": "string",
          "enum": ["A0", "A1", "A2", "A3", "A4"]
        },
        "scale": { "type": "string", "pattern": "^1:\\d+$" },
        "viewIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "titleBlockTemplate": {
          "type": "string",
          "enum": ["standard", "compact", "minimal"]
        },
        "titleBlock": { "$ref": "#/$defs/SheetTitleBlock" },
        "viewports": {
          "type": "array",
          "items": { "$ref": "#/$defs/Viewport" }
        }
      }
    },
    "SheetTitleBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectName": { "type": "string" },
        "drawingTitle": { "type": "string" },
        "drawnBy": { "type": "string" },
        "checkedBy": { "type": "string" },
        "issueDate": { "type": "string" },
        "revision": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "ConstructionLine": {
      "type": "object",
      "required": ["id", "story", "type", "origin", "direction"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "story": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["xline", "ray"] },
        "origin": { "$ref": "#/$defs/Point2D" },
        "direction": { "$ref": "#/$defs/Point2D" }
      }
    },
    "ExternalRef": {
      "type": "object",
      "required": ["id", "name", "data", "offsetX", "offsetY", "visible"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "data": { "$ref": "#" },
        "offsetX": { "type": "number" },
        "offsetY": { "type": "number" },
        "visible": { "type": "boolean" }
      }
    },
    "Issue": {
      "type": "object",
      "required": ["level", "message"],
      "additionalProperties": false,
      "properties": {
        "level": { "type": "string", "enum": ["error", "warning", "info"] },
        "message": { "type": "string" },
        "memberId": { "type": "string" }
      }
    },
    "Group": {
      "type": "object",
      "required": ["id", "name", "memberIds"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "memberIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
